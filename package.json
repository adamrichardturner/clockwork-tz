{
  "name": "clockwork-tz",
  "version": "1.0.0-alpha.1",
  "description": "Accurate timezone conversions and DST handling with optional deterministic IANA tzdb support",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tzdb": {
      "import": {
        "types": "./dist/tzdb.d.ts",
        "default": "./dist/tzdb.js"
      },
      "require": {
        "types": "./dist/tzdb.d.cts",
        "default": "./dist/tzdb.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest --project node",
    "test:run": "vitest run --project node",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build && npm run test:run && npm run check:pkg",
    "check:pkg": "publint && attw --pack .",
    "build:tzdb": "node scripts/build-tzdb.ts",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --project node --coverage"
  },
  "keywords": [
    "timezone",
    "tz",
    "datetime",
    "dst",
    "daylight-saving",
    "iana",
    "tzdb",
    "date",
    "time",
    "intl",
    "conversion",
    "offset"
  ],
  "author": "Adam Turner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamrichardturner/clockwork-tz.git"
  },
  "bugs": {
    "url": "https://github.com/adamrichardturner/clockwork-tz/issues"
  },
  "homepage": "https://github.com/adamrichardturner/clockwork-tz#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.4",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
