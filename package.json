{
  "name": "clockwork-tz",
  "version": "1.0.0-alpha.1",
  "description": "Accurate timezone conversions and DST handling with optional deterministic IANA tzdb support",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.browser.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install",
    "prepublishOnly": "npm run typecheck && npm run build && npm run test:run"
  },
  "keywords": [
    "timezone",
    "tz",
    "datetime",
    "dst",
    "daylight-saving",
    "iana",
    "tzdb",
    "date",
    "time",
    "intl",
    "conversion",
    "offset"
  ],
  "author": "Adam Turner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamrichardturner/clockwork-tz.git"
  },
  "bugs": {
    "url": "https://github.com/adamrichardturner/clockwork-tz/issues"
  },
  "homepage": "https://github.com/adamrichardturner/clockwork-tz#readme",
  "dependencies": {
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "prettier": "^3.3.2",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
